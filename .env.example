# S3-compatible storage credentials (iDrive e2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL=

# Buckets
S3_PDF_BUCKET=temporalpdfs
S3_PARSED_MDS=parsedmds

# Local scratch space
# PDFs land in  <TEMP_PD_DIR>/<TEMP_PDF_FOLDER>
# Markdown lands in <TEMP_PD_DIR>/<TEMP_MD_FOLDER>
TEMP_PD_DIR=assets
TEMP_PDF_FOLDER=TEMP_PDF
TEMP_MD_FOLDER=TEMP_MD

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=process_pdf_queue

# Run the worker inside the API process, so `uv run main.py` is enough on its
# own. Convenient locally; leave it false in production and run workers/ apart
# so a slow parse cannot starve request handling and work survives an API restart.
RUN_WORKER_IN_API=false

# Logging
LOG_LEVEL=INFO

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
LLM_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legal advice pipeline
S3_LEGAL_ADVICE=legaladvice
LEGAL_TASK_QUEUE=legal_advice_queue
LEGAL_MAX_CONCURRENT_PDFS=10
LEGAL_PAGES_PER_BATCH=30
LEGAL_MAX_PDFS=20
HUMAN_INPUT_TIMEOUT_SECONDS=3600
